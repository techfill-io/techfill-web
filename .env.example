# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase Configuration (for authentication only)
# Get from: Supabase Dashboard > Project Settings > API
# Client-side (bundled into browser JS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Server-side (used by API routes, middleware, server components)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
